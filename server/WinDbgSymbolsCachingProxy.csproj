        <PackageReference Include="System.Security.Cryptography.Pkcs" />
        <PackageReference Include="Microsoft.FileFormats" />
        <PackageReference Include="Microsoft.SymbolStore" />
        <PackageReference Include="MinVer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="MongoDB.Entities" />
        <PackageReference Include="Nefarius.Shared.PdbUtils" />
        <PackageReference Include="Nefarius.Utilities.AspNetCore" />
        <PackageReference Include="MudBlazor" />
        <PackageReference Include="PeNet" />
        <PackageReference Include="Resourcer.Fody">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Riok.Mapperly" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
        <PackageReference Include="Smx.PDBSharp" />
        <PackageReference Include="Smx.SharpIO" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="favicon.ico" />
        <EmbeddedResource Include="favicon.ico" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="WinDbgSymbolsCachingProxy.Server.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\shared\WinDbgSymbolsCachingProxy.UpdateCheck\WinDbgSymbolsCachingProxy.UpdateCheck.csproj" />
