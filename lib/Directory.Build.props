<Project>

    <PropertyGroup>
        <!-- Copyright information -->
        <Authors>Benjamin Höglinger-Stelzer</Authors>
        <Copyright>Copyright © Benjamin Höglinger-Stelzer 2026</Copyright>

        <!-- Package Icon -->
        <PackageIcon>NSS-128x128.png</PackageIcon>
        <PackageIconUrl/>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Common settings -->
        <LangVersion>latest</LangVersion>

        <!-- Docs and symbols generation -->
        <!-- packing happens explicitly (dotnet pack); not on every build -->
        <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(ProjectDir)..\assets\NSS-128x128.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="$(ProjectDir)README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>