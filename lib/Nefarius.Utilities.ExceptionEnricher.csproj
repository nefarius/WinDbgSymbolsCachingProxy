<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <RootNamespace>Nefarius.Utilities.ExceptionEnricher</RootNamespace>

        <Description>Rebuilds exception stack traces with file names and line numbers by downloading the matching debug symbols from a symbol server on demand.</Description>
        <PackageTags>exception;stacktrace;pdb;symbols;symbol-server;debugging;diagnostics</PackageTags>
        <PackageProjectUrl>https://github.com/nefarius/WinDbgSymbolsCachingProxy</PackageProjectUrl>
        <RepositoryUrl>https://github.com/nefarius/WinDbgSymbolsCachingProxy.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <PropertyGroup>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <!-- 2.0 removes the FastDeepCloner/ClrMD dependencies and changes the resolution behavior. -->
        <MinVerMinimumMajorMinor>2.0</MinVerMinimumMajorMinor>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="MinVer">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Mono.Cecil" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nefarius.Utilities.ExceptionEnricher.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
